# --- Core ---
DATABASE_URL=postgresql://prospect:prospect@localhost:5432/prospect
REDIS_URL=redis://localhost:6379
APP_SECRET=change-me-to-a-long-random-string-32chars

# --- Execution mode ---
# MOCK_MODE=true runs the full pipeline on bundled, clearly-labeled mock data (no live internet).
# Set to false only after connecting real providers below.
MOCK_MODE=true
# RUN_JOBS_INLINE=true runs pipelines in-process (no Redis needed). Set false to use BullMQ worker.
RUN_JOBS_INLINE=true

# --- Storage ---
STORAGE_DIR=./storage
# STORAGE_DRIVER=local | s3 (s3 is a stub interface; implement credentials before use)
STORAGE_DRIVER=local

# --- Analysis service ---
# If set, analysis runs via HTTP (docker-compose sets this). If empty, spawns PYTHON_BIN analysis/cli.py locally.
ANALYSIS_SERVICE_URL=
PYTHON_BIN=python3

# --- Search providers (pluggable) ---
# SEARCH_PROVIDER=mock | brave
SEARCH_PROVIDER=mock
BRAVE_API_KEY=

# --- Official data APIs (preferred over scraping) ---
EIA_API_KEY=
FRED_API_KEY=

# --- Compliant collection settings ---
SCRAPER_USER_AGENT="ProspectResearchBot/0.1 (+https://example.com/bot; research contact: you@example.com)"
RATE_LIMIT_MS=3000
HTTP_TIMEOUT_MS=15000
MAX_SOURCES_PER_RUN=8
# Comma-separated domains never collected from (admin source rules)
DOMAIN_BLOCKLIST=
