generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  projects      ResearchProject[]
  scheduledJobs ScheduledJob[]
  notifications Notification[]
  integrations  IntegrationSetting[]
  auditLogs     AuditLog[]
}

model ResearchProject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  createdAt DateTime @default(now())
  questions ResearchQuestion[]
  runs      ResearchRun[]
  scheduledJobs ScheduledJob[]
}

model ResearchQuestion {
  id        String   @id @default(cuid())
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id])
  text      String
  createdAt DateTime @default(now())
  runs      ResearchRun[]
}

enum RunStatus {
  QUEUED
  PLANNING
  SEARCHING
  EVALUATING
  COLLECTING
  TRANSFORMING
  ANALYZING
  REPORTING
  COMPLETED
  FAILED
}

model ResearchRun {
  id           String    @id @default(cuid())
  projectId    String
  project      ResearchProject @relation(fields: [projectId], references: [id])
  questionId   String
  question     ResearchQuestion @relation(fields: [questionId], references: [id])
  status       RunStatus @default(QUEUED)
  triggeredBy  String    @default("MANUAL") // MANUAL | SCHEDULE
  scheduledJobId String?
  error        String?
  mockMode     Boolean   @default(true)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  plan         ResearchPlan?
  searchQueries SearchQuery[]
  sources      Source[]
  rawData      RawCollectedData[]
  datasets     ProcessedDataset[]
  analysisRuns AnalysisRun[]
  insights     Insight[]
  reports      Report[]
  auditLogs    AuditLog[]
  notifications Notification[]
}

model ResearchPlan {
  id             String @id @default(cuid())
  runId          String @unique
  run            ResearchRun @relation(fields: [runId], references: [id])
  targetVariable String
  taskType       String
  timeHorizon    String
  geography      String?
  domain         String
  dataNeeds      Json
  sourceCategories Json
  searchQueries  Json
  analysisApproach String
  expectedOutputs Json
  raw            Json
  createdAt      DateTime @default(now())
}

model SearchQuery {
  id          String   @id @default(cuid())
  runId       String
  run         ResearchRun @relation(fields: [runId], references: [id])
  query       String
  provider    String
  resultCount Int
  results     Json
  createdAt   DateTime @default(now())
}

model Source {
  id           String  @id @default(cuid())
  runId        String
  run          ResearchRun @relation(fields: [runId], references: [id])
  url          String
  domain       String
  title        String
  category     String
  tier         Int
  discoveredVia String?
  supportsStructuredData Boolean @default(false)
  evaluation   SourceEvaluation?
  rawData      RawCollectedData[]
}

model SourceEvaluation {
  id              String  @id @default(cuid())
  sourceId        String  @unique
  source          Source  @relation(fields: [sourceId], references: [id])
  authority       Float
  recency         Float
  relevance       Float
  dataAvailability Float
  accessibility   Float
  licensing       Float
  totalScore      Float
  selected        Boolean
  reason          String
}

model RawCollectedData {
  id          String   @id @default(cuid())
  runId       String
  run         ResearchRun @relation(fields: [runId], references: [id])
  sourceId    String?
  source      Source?  @relation(fields: [sourceId], references: [id])
  name        String
  method      String   // api | csv_download | rss | html_table | mock | upload
  contentType String
  snapshotPath String
  recordCount Int?
  isMock      Boolean  @default(false)
  notes       Json
  collectedAt DateTime @default(now())
}

model ProcessedDataset {
  id           String   @id @default(cuid())
  runId        String
  run          ResearchRun @relation(fields: [runId], references: [id])
  name         String
  description  String
  rowCount     Int
  columnCount  Int
  schemaJson   Json
  qualityNotes Json
  assumptions  Json
  sourceUrls   Json
  createdAt    DateTime @default(now())
  files        DatasetFile[]
}

model DatasetFile {
  id        String   @id @default(cuid())
  datasetId String
  dataset   ProcessedDataset @relation(fields: [datasetId], references: [id])
  kind      String   // PROCESSED_CSV | DICTIONARY_JSON | RAW_SNAPSHOT
  path      String
  filename  String
  sizeBytes Int
  createdAt DateTime @default(now())
}

model AnalysisRun {
  id            String   @id @default(cuid())
  runId         String
  run           ResearchRun @relation(fields: [runId], references: [id])
  method        String
  params        Json
  results       Json
  confidence    String
  engineVersion String
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  insights      Insight[]
}

model Insight {
  id            String  @id @default(cuid())
  runId         String
  run           ResearchRun @relation(fields: [runId], references: [id])
  analysisRunId String?
  analysisRun   AnalysisRun? @relation(fields: [analysisRunId], references: [id])
  kind          String  // finding | risk | recommendation | signal
  title         String
  body          String
  importance    Int     @default(3)
}

model Report {
  id        String   @id @default(cuid())
  runId     String
  run       ResearchRun @relation(fields: [runId], references: [id])
  format    String   // markdown | html
  path      String
  summary   String
  createdAt DateTime @default(now())
}

model ScheduledJob {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  projectId    String?
  project      ResearchProject? @relation(fields: [projectId], references: [id])
  questionText String
  cron         String
  enabled      Boolean  @default(true)
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  runId     String?
  run       ResearchRun? @relation(fields: [runId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  step      String
  level     String   @default("info")
  message   String
  data      Json?
  createdAt DateTime @default(now())
}

model IntegrationSetting {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  provider       String   // brave | eia | fred | s3 ...
  encryptedValue String   // AES-256-GCM encrypted with APP_SECRET-derived key
  createdAt      DateTime @default(now())

  @@unique([userId, provider])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  runId     String?
  run       ResearchRun? @relation(fields: [runId], references: [id])
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}
